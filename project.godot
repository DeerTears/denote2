; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Denote 3D"
config/description="A playground of many 3D game mechanics, featuring audio, volumetric fog, and surrealist art styles."
run/main_scene="uid://dvdrd140u0p7t"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://8wp6v5jjcdmm"

[audio]

buses/default_bus_layout="uid://c5qilqelbpunb"

[autoload]

MusicPlayer="*uid://irvusf5277a2"
GameSettings="*uid://bfiifwhnbdobl"

[display]

window/size/viewport_width=1080
window/size/viewport_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-eyesee/plugin.cfg")

[global_group]

EditorOnly="Deleted on play"

